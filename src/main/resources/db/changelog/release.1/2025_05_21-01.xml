<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="2025_05_21-01" author="p.vydysh">
        <preConditions>
            <not>
                <tableExists tableName="poll"/>
            </not>
        </preConditions>

        <createTable tableName="poll"
                     remarks="Информация об опросах">
            <column name="poll_id"
                    type="UUID"
                    remarks="Идентификатор опроса">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="author_id"
                    type="TEXT"
                    remarks="Идентификатор автора">
                <constraints nullable="false"/>
            </column>
            <column name="author_name"
                    type="TEXT"
                    remarks="Имя автора">
                <constraints nullable="false"/>
            </column>
            <column name="status"
                    type="TEXT"
                    remarks="Статус опроса">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025_05_21-02" author="p.vydysh">
        <preConditions>
            <not>
                <tableExists tableName="poll_version"/>
            </not>
        </preConditions>

        <createTable tableName="poll_version"
                     remarks="Информация о версиях опросов">
            <column name="poll_version_id"
                    type="UUID"
                    remarks="Идентификатор версии">
                <constraints primaryKey="true"/>
            </column>
            <column name="poll_id"
                    type="UUID"
                    remarks="Идентификатор опроса">
                <constraints nullable="false"/>
            </column>
            <column name="title"
                    type="TEXT"
                    remarks="Заголовок опроса">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date"
                    type="TIMESTAMPTZ"
                    remarks="Дата создания версии">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_poll_version_poll"
                                 baseTableName="poll_version"
                                 baseColumnNames="poll_id"
                                 referencedTableName="poll"
                                 referencedColumnNames="poll_id"
                                 onUpdate="CASCADE"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="2025_05_21-03" author="p.vydysh">
        <preConditions>
            <not>
                <tableExists tableName="available_answer"/>
            </not>
        </preConditions>

        <createTable tableName="available_answer"
                     remarks="Информация о допустимых вариантов ответов">
            <column name="available_answer_id"
                    type="UUID"
                    remarks="Идентификатор допустимого варианта ответа">
                <constraints primaryKey="true"/>
            </column>
            <column name="title"
                    type="TEXT"
                    remarks="Текст варианта ответа">
                <constraints nullable="false"/>
            </column>
            <column name="position"
                    type="INT"
                    remarks="Порядковый номер варианта ответа">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2025_05_21-04" author="p.vydysh">
        <preConditions>
            <not>
                <tableExists tableName="poll_version_available_answer"/>
            </not>
        </preConditions>

        <createTable tableName="poll_version_available_answer"
                     remarks="Информация о связи варианта ответа с версией опроса">
            <column name="poll_version_id"
                    type="UUID"
                    remarks="Идентификатор версии">
                <constraints nullable="false"/>
            </column>
            <column name="available_answer_id"
                    type="UUID"
                    remarks="Идентификатор варианта ответа">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="poll_version_available_answer_to_poll_version"
                                 baseTableName="poll_version_available_answer"
                                 baseColumnNames="poll_version_id"
                                 referencedTableName="poll_version"
                                 referencedColumnNames="poll_version_id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"/>

        <addForeignKeyConstraint constraintName="poll_version_available_answer_to_available_answer"
                                 baseTableName="poll_version_available_answer"
                                 baseColumnNames="available_answer_id"
                                 referencedTableName="available_answer"
                                 referencedColumnNames="available_answer_id"
                                 onDelete="CASCADE"
                                 onUpdate="CASCADE"/>
    </changeSet>

</databaseChangeLog>
